# 開發用 SQLite；正式環境改成 PostgreSQL，並把 schema.prisma 的 provider 改為 postgresql
DATABASE_URL="file:./dev.db"

# 網站對外網址（用於 QR 碼連結）
APP_URL="http://localhost:3000"

# 好事道整合模式：mock（模擬）或 live（正式 API，待好事道提供）
GOODDEEDS_MODE="mock"
GOODDEEDS_API_BASE=""
GOODDEEDS_API_KEY=""

# 捐款金流連結（好事公益協會的藍新捐款頁）
DONATION_URL=""

# 好事道訊息幾小時未讀就提醒改打電話
CONTACT_FALLBACK_HOURS="24"
